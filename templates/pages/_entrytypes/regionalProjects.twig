{% extends "_layouts/generic-page-layout.twig" %}
{% block content %}
    {%  set layout = null %}
    <!-- Page Content -->
    {%  if entry is defined %}

{#        {% include '/_includes/hero-featured.twig' %}#}

{% cache %}


    {%  set tagID = entry.locationtags.one().id %}
    {% set relatedTo = [
        'and',
        {
            field: 'locationtags',
            targetElement:  tagID
        }
    ] %}
    {% set entries = craft.entries()
        .section('projects')
        .with(['locationtags']).relatedTo(relatedTo)
        .all() %}
<!-- service regional projects-->

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12 text-center">
                <h5 class="section-title-sm">Our work</h5>
                <h1 class="section-title section-title-border">{{ entry.title }}</h1>
            </div>
            {%  if entry.introText | length %}
            <div class="row ">
                <div class="col-sm-12 col-md-10 offset-md-1 text-center pb-5">
                    <p class="lead">{{entry.introText | striptags | raw}}</p>
                </div>
            </div>
            {% endif %}

            <div class="row">
                <div class="col-12 col-md-10 offset-md-1">
                    <div class="card-group mb-5">
                        {% if entries | length %}
                        {% for entry in entries %}
                            {% if entry.projectImage.exists() %}
                                {% set asset = entry.projectImage.one() %}
                            {% endif %}

                            <div class="col-lg-6 col-sm-6 mb-5 mb-lg-3">
                                <div class="card text-center mb-4">
                                    {%  if asset | length %}
                                        {% set img = craft.imager.transformImage(asset,
                                            [
                                                { width: 360, height:230, position: asset.getFocalPoint(), jpegQuality:85},
                                            ]
                                        ) %}
                                        <a href="{{ entry.url }}">
                                            <div class="card-img-wrapper overlay-rounded-top">
                                                <img class="card-img-top rounded-0" src="{{ img[0].url }}" alt="{{ entry.title}}">
                                            </div>
                                        </a>
                                    {% endif %}
                                    <div class="card-body py-3" data-mh="cardtext">
                                        <h4 class="card-title pt-3"> <a href="{{ entry.url }}">{{ entry.title }}</a></h4>
                                        <p class="card-text mx-2 mb-3" data-mh="mhtext">{{ entry.subTitle| striptags }}.</p>


                                    </div>
                                </div>
                            </div>

                        {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>



        </div>
    </div><!-- /.container -->
</section>
<!-- index-research borrowed -->
<section class="section publications ">
        <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-12 text-center">
                <h1 class="section-title section-title-border">Research & Policy</h1>
            </div>
            {# <div class="col-sm-12 col-lg-10  text-center ">

                <p class="lead">{{ entry.introText | replace("&amp;", "&") | striptags }}</p>

            </div>
        </div> #}
    </div>
    <div class="container">
        <div class="row justify-content-center">

            {% set categories = craft.categories({
            group: 'research',
            limit: null,
            }) %}
            {% set entries = craft.entries({
            section: 'publications',
            relatedTo:categories
            }).limit('10') %}

            {% paginate entries as pageInfo, pageEntries %}
            {# card based layout #}
            <div class="container">
                <div class="row justify-content-center">
                    {#<div class="col-xs-12   mb-5">#}

                        {#{% for entry in entries %}#}
                        {% for entry in pageEntries %}

                        {% set pdfImage = entry.pdfThumbnailImage[0] ?? null %}
                        {% set thumb = {
                        mode: 'crop',
                        width: 253,
                        height: 358

                        } %}
                        <div class="col-lg-3 col-sm-6 col-xs-12 mb-1 ">
                            <div class="card text-center mb-5">
                                <a href="{{ entry.url }}">
                                    <div class="card-img-wrapper">
                                        {% if pdfImage |length %}
                                        <img class="card-img-top rounded-0" height="350" src="{{ pdfImage.getUrl() }}"
                                            alt="">
                                        {% endif %}
                                    </div>
                                </a>
                                <div class="card-body p-2">
                                    <h4 class="card-title pt-3" data-mh="title"><a class="text-black"
                                            href="{{ entry.url }}">{{ entry.title }}</a></h4>

                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div><!-- /.container -->
</section>
{% endcache %}
    {%  endif %}


{% endblock %}
